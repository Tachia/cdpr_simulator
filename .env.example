# cdpr — environment variables
#
# Copy to `.env` for local development; the actual `.env` is gitignored.
# Production values live in each platform's secrets UI (Render, Streamlit
# Community Cloud, Supabase). Nothing in the cdpr core reads from env vars
# directly --- the variables below configure the interface and deployment
# layers only.


# ---------------------------------------------------------------------------
# FastAPI backend (cdpr.interface.api)
# ---------------------------------------------------------------------------

# Bind address + port. Render sets PORT itself; only override locally.
CDPR_API_HOST=0.0.0.0
CDPR_API_PORT=8000

# Comma-separated list of allowed CORS origins. Include the Streamlit
# Community Cloud URL once it's known.
CDPR_API_CORS_ORIGINS=http://localhost:8501


# ---------------------------------------------------------------------------
# Streamlit research console (cdpr.interface.gui)
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend the console should talk to.
CDPR_BACKEND_URL=http://localhost:8000


# ---------------------------------------------------------------------------
# Supabase (optional --- only if persistent storage is wired)
# ---------------------------------------------------------------------------

# Project URL and anon (browser-safe) key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key for the FastAPI backend. NEVER ship to the frontend.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Render
# ---------------------------------------------------------------------------

# Set automatically by Render. Local override only if you really need to.
# PORT=10000


# ---------------------------------------------------------------------------
# LLM providers (cdpr.llm)
# ---------------------------------------------------------------------------
# The simulator's chat / explanation / conversational-simulation-builder
# tooling picks a provider from these env vars. None is required for the
# core simulator to work --- the echo stub fills in when no provider is
# configured. See docs/llm-providers.md for the full setup walkthrough.

# Optional: pin a specific provider. When unset, the factory picks the
# first one whose keys are present (Gemini > OpenRouter > Ollama > LMStudio
# > echo).
# CDPR_LLM_PROVIDER=gemini

# Gemini (recommended default --- free tier).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model override; default gemini-1.5-flash.
# GEMINI_MODEL=gemini-1.5-flash

# OpenRouter (covers DeepSeek-R1 math reasoning and DeepSeek-V3 code).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-r1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (fully local --- install from https://ollama.com/download).
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# LM Studio (local OpenAI-compatible server --- https://lmstudio.ai/).
# LMSTUDIO_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model
