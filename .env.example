# cdpr — environment variables
#
# Copy to `.env` for local development; the actual `.env` is gitignored.
# Production values live in each platform's secrets UI (Render, Streamlit
# Community Cloud, Supabase). Nothing in the cdpr core reads from env vars
# directly --- the variables below configure the interface and deployment
# layers only.


# ---------------------------------------------------------------------------
# FastAPI backend (cdpr.interface.api)
# ---------------------------------------------------------------------------

# Bind address + port. Render sets PORT itself; only override locally.
CDPR_API_HOST=0.0.0.0
CDPR_API_PORT=8000

# Comma-separated list of allowed CORS origins. Include the Streamlit
# Community Cloud URL once it's known.
CDPR_API_CORS_ORIGINS=http://localhost:8501


# ---------------------------------------------------------------------------
# Streamlit research console (cdpr.interface.gui)
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend the console should talk to.
CDPR_BACKEND_URL=http://localhost:8000


# ---------------------------------------------------------------------------
# Supabase (optional --- only if persistent storage is wired)
# ---------------------------------------------------------------------------

# Project URL and anon (browser-safe) key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key for the FastAPI backend. NEVER ship to the frontend.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Render
# ---------------------------------------------------------------------------

# Set automatically by Render. Local override only if you really need to.
# PORT=10000
